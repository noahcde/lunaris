# Copiez ce fichier en .env.local et remplissez-le avec la config de votre app web Firebase
# (Console Firebase > Paramètres du projet > Vos applications > Config).
# Sans ces valeurs, l'app tourne en mode démo (connexion simulée, données dans le navigateur).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
